# API Keys (Optional - comment out if using free alternatives)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# TTS Configuration
DEFAULT_TTS_ENGINE=gtts  # Options: elevenlabs, gtts, pyttsx3
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Default voice

# AI Configuration
AI_MODEL=gpt-3.5-turbo  # or use local model
MAX_RESPONSE_LENGTH=100

# -----------------------------------------------
# Speech-to-Text
# -----------------------------------------------
DEFAULT_STT_ENGINE=google   # Options: whisper, google
WHISPER_MODEL=base          # Options: tiny, base, small, medium, large

# -----------------------------------------------
# Push Notifications (Firebase Cloud Messaging)
# Get server key from Firebase Console → Project Settings → Cloud Messaging
# -----------------------------------------------
FCM_SERVER_KEY=your_fcm_server_key_here

# -----------------------------------------------
# Scam DB Auto-Sync
# -----------------------------------------------
AUTO_SYNC_SCAM_DB=true      # Set false to disable background sync
SYNC_INTERVAL_HOURS=24

# -----------------------------------------------
# Scambaiter / Outbound Calling (Twilio)
# Sign up free: https://www.twilio.com/try-twilio
# -----------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567   # Your Twilio number

# Public URL so Twilio can reach your webhooks
# Use ngrok for local dev: ngrok http 8000
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.io
